{
  "binding_dir": "bindings",
  "config": {
    "allow_non_loopback": true,
    "allowed_peer_ips": [
      "<ANALYZER_IP>"
    ],
    "bind_host": "<GATEWAY_INTERFACE_IP>",
    "bind_port": 2100,
    "idle_timeout": 30,
    "ingest_timeout": 60,
    "max_connections": 2,
    "max_frame_bytes": 1048576,
    "queue_capacity": 32,
    "tls_certfile": "tls/site-server-chain.pem",
    "tls_enabled": true,
    "tls_keyfile": "tls/site-server-key.pem",
    "tls_require_client_cert": false
  },
  "kind": "roche-cobas-liat-v2.0",
  "source_id": "<REGISTERED_LIVE_SHADOW_SOURCE_ID>",
  "transport_id": "<SITE_TRANSPORT_ID>"
}
